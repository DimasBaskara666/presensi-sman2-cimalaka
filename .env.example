# Public Supabase values used by browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
AUTH_EMAIL_DOMAIN=auth.your-school.example
ACTIVATION_CODE_PEPPER=

# One-time development Admin provisioning. Keep the real password only in .env.local.
DEV_ADMIN_LOGIN_ID=ADMIN
DEV_ADMIN_FULL_NAME=Development Administrator
DEV_ADMIN_PASSWORD=
DEV_ADMIN_NEW_PASSWORD=

# Development Teacher integration fixture. Keep every real password only in .env.local.
DEV_TEACHER_LOGIN_ID=G001
DEV_TEACHER_FULL_NAME=Development Teacher
DEV_TEACHER_PASSWORD=
DEV_TEACHER_SELF_PASSWORD=
DEV_TEACHER_RESET_PASSWORD=

# Trusted public origin used for metadata and future QR URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
