# Public Supabase values used by browser and server clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
AUTH_EMAIL_DOMAIN=auth.your-school.example
ACTIVATION_CODE_PEPPER=

# Trusted public origin used for metadata and future QR URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
